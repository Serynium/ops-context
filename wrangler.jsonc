{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ops-context",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-29",
  "minify": true,
  "upload_source_maps": true,

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/mcp"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ops-context",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "ops-context-push"
      }
    ],
    "consumers": [
      {
        "queue": "ops-context-push",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ops-context-push-dlq",
        "max_concurrency": 4
      },
      {
        "queue": "ops-context-push-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "max_concurrency": 1
      }
    ]
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "OPS_ADMIN_USER": "admin",
    "OPS_RETENTION_DAYS": "90",
    "OPS_PUSH_MAX_ATTEMPTS": "6",
    "OPS_BASE_URL": "https://ops.example.com"
  },

  "observability": {
    "enabled": true
  }
}
